<% @page_title = "Join links are off" %>

<div class="panel panel--centered flex flex-column gap-half">
  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>

  <p class="txt-medium margin-none-block-start margin-block-end">
    This Fizzy uses <%= SingleSignOn.provider_name %> sign-in. To join <%= @join_code.account.name %>,
    ask an admin to add you to its <%= SingleSignOn.provider_name %> group.
  </p>

  <%= button_to "Sign in with #{SingleSignOn.provider_name}", session_single_sign_on_path(script_name: nil),
        class: "btn btn--link center txt-medium",
        form: { data: { turbo: false, controller: "clear-offline-cache", action: "submit->clear-offline-cache#clearCache" } } %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
