<header class="work-plan__heading flex align-start justify-space-between gap">
  <div>
    <h2>Plan work</h2>
    <p class="txt-small txt-subtle">Balance the unassigned cards. Nothing changes until you approve.</p>
  </div>
  <button type="button" class="btn btn--plain txt-small" data-action="dialog#close" aria-label="Close work plan">Close</button>
</header>

<%= turbo_frame_tag(dom_id(board, :work_plan), src: board_work_plan_path(board), loading: "lazy", data: {
      controller: "work-plan",
      work_plan_time_limit_value: board.work_planning_time_limit_in_seconds,
      action: "turbo:before-fetch-request->work-plan#start turbo:frame-load->work-plan#stop"
    }) do %>
  <%= render "boards/work_plans/loading", board: board %>
<% end %>
