<%# Who is asking, as far as Fizzy can vouch for it, under the heading that
    names it. A self-registered app's name is only its claim, typed by whoever
    registered it, so it's shown as exactly that: quoted and subdued, beside a
    caution, with the heading naming where its access goes. bdi keeps any
    right-to-left letters in the name from moving the quotes. %>
<% if client.dynamically_registered? %>
  <header class="oauth-client flex flex-column gap-half">
    <p class="oauth-client__self-name txt-small txt-subtle margin-none">
      Says it&rsquo;s &ldquo;<bdi><%= oauth_client_self_name(client) %></bdi>&rdquo;
    </p>

    <p class="oauth-client__warning txt-small margin-none" role="note">
      <% if oauth_redirect_host(redirect_uri) %>
        <strong>We haven&rsquo;t checked this app.</strong> Only authorize it if you trust that address.
      <% else %>
        <strong>We haven&rsquo;t checked this app.</strong> Only authorize it if you started it.
      <% end %>
    </p>
  </header>
<% elsif client.metadata_document? %>
  <p class="oauth-client__self-name txt-small txt-subtle margin-none">
    Name set by the app at <strong><%= URI.parse(client.client_id).host %></strong>.
  </p>
<% elsif client.trusted? %>
  <p class="oauth-client__made-by txt-small txt-subtle margin-none">Made by 37signals.</p>
<% end %>
