<%# The app's name, and under it who set it, as Connected apps shows it
    (my/connected_apps/connected_app). A self-registered app's name is only its
    claim, typed by whoever registered it, so the line beneath names where this
    request's access goes, the one thing about it Fizzy can vouch for, and a
    caution follows. bdi keeps any right-to-left letters in the name from
    reordering the text around it. %>
<% redirect_host = oauth_redirect_host(redirect_uri) %>

<header class="oauth-client flex flex-column gap">
  <div class="oauth-client__identity">
    <h2 class="oauth-client__name txt-large margin-none"><bdi><%= oauth_client_self_name(client) %></bdi></h2>

    <% if client.dynamically_registered? %>
      <p class="oauth-client__byline txt-small txt-subtle margin-none">
        <% if redirect_host %>
          Name set by the app at <%= redirect_host %>
        <% else %>
          Name set by an app on your device
        <% end %>
      </p>
    <% elsif client.metadata_document? %>
      <p class="oauth-client__byline txt-small txt-subtle margin-none">Name set by the app at <%= URI.parse(client.client_id).host %></p>
    <% elsif client.trusted? %>
      <p class="oauth-client__byline txt-small txt-subtle margin-none">Made by 37signals</p>
    <% end %>
  </div>

  <% if client.dynamically_registered? %>
    <p class="oauth-client__warning txt-small margin-none" role="note">
      <% if redirect_host %>
        <strong>We haven&rsquo;t checked this app.</strong> Only authorize it if you trust that address.
      <% else %>
        <strong>We haven&rsquo;t checked this app.</strong> Only authorize it if you started it.
      <% end %>
    </p>
  <% end %>
</header>
