<% identity = oauth_client_display_identity(@client, @redirect_uri) %>
<% redirect_host = oauth_redirect_host(@redirect_uri) %>
<% @page_title = "Authorize #{identity}" %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
<% end %>

<article class="oauth-consent panel panel--wide shadow center txt-align-start">
  <%= render "oauth/authorizations/client", client: @client, identity: identity, redirect_host: redirect_host %>

  <%# Not you? signs out and returns whoever signs in to this same request %>
  <div class="oauth-consent__identity flex align-center gap-half txt-small txt-subtle">
    <span>Signed in as <strong><%= Current.identity.email_address %></strong></span>
    <%= button_to "Not you?", oauth_authorization_switch_path,
          params: { client_id: @client.client_id, redirect_uri: @redirect_uri, response_type: "code", scope: @scope,
            state: @state, code_challenge: @code_challenge, code_challenge_method: "S256", resource: @resource }.compact,
          class: "btn btn--plain txt-link txt-small", form: { data: { turbo: false } } %>
  </div>

  <%= form_with url: oauth_authorization_path, method: :post, data: { turbo: false }, html: { class: "flex flex-column gap" } do |f| %>
    <%= f.hidden_field :client_id, value: @client.client_id %>
    <%= f.hidden_field :redirect_uri, value: @redirect_uri %>
    <%= f.hidden_field :state, value: @state %>
    <%= f.hidden_field :code_challenge, value: @code_challenge %>
    <%= f.hidden_field :code_challenge_method, value: "S256" %>
    <%= f.hidden_field :response_type, value: "code" %>
    <%= f.hidden_field :resource, value: @resource if @resource %>

    <%# Account binding sets @accounts: a connection then reaches the one account chosen here %>
    <% if @accounts %>
      <%= render "oauth/authorizations/account_picker", form: f, accounts: @accounts, selected_account_id: @account_id %>
    <% end %>

    <%= render "oauth/authorizations/access", form: f, client: @client, scope: @scope, one_account: @accounts.present? %>

    <p class="oauth-consent__destination txt-small txt-subtle margin-none">
      <% if redirect_host %>
        Either way, you'll go back to <strong><%= redirect_host %></strong>.
      <% else %>
        Either way, you'll go back to the app on your device.
      <% end %>
      You can disconnect it at any time in <%= link_to "Connected apps", my_connected_apps_path, class: "txt-link" %>.
    </p>

    <div class="oauth-consent__actions flex gap">
      <%= f.button type: :submit, class: "btn btn--link txt-medium" do %>
        <span>Authorize</span>
      <% end %>

      <%= f.button type: :submit, name: :error, value: "access_denied", class: "btn btn--outline txt-medium" do %>
        <span>Deny</span>
      <% end %>
    </div>
  <% end %>
</article>
