<%# Shown on Fizzy, never redirected: the request couldn't be trusted enough
    to send the browser back to the app (see redirect_with_error). The person
    reads what went wrong in plain words, and nothing more: the OAuth error
    code would mean nothing to them. %>
<% @page_title = "Can't authorize this app" %>

<article class="oauth-consent panel panel--wide shadow center txt-align-start margin-block-start-half" data-oauth-error="<%= @error %>">
  <div class="flex flex-column gap">
    <h2 class="txt-large margin-none"><%= @page_title %></h2>

    <p class="margin-none"><%= oauth_error_message(@error, @error_message) %></p>

    <p class="txt-small txt-subtle margin-none">
      Nothing was shared. Close this window and start again from the app. If it keeps happening, let whoever made the app know.
    </p>
  </div>
</article>
