<%# Shown on Fizzy, never redirected: the request couldn't be trusted enough
    to send the browser back to the app (see redirect_with_error) %>
<% @page_title = "Can't authorize this app" %>

<article class="oauth-consent panel panel--wide shadow center txt-align-start">
  <div class="flex flex-column gap">
    <h2 class="txt-large margin-none"><%= @page_title %></h2>

    <p class="margin-none"><%= @error_description %></p>

    <p class="txt-small txt-subtle margin-none">
      Nothing was shared. Close this window and start again from the app. If it keeps happening, let whoever made the app know, and mention this error code: <code><%= @error %></code>
    </p>
  </div>
</article>
