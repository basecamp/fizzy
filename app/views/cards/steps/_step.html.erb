<%= turbo_frame_tag step do %>
  <li class="step">
    <%= form_with model: [step.card, step], data: { controller: "form" } do |form| %>
      <%= form.check_box :completed, { class: "checkbox", disabled: step.card.board_archived?, data: { action: "change->form#submit" } } %>
    <% end %>
    <%= link_to_unless(step.card.board_archived?, step.content, edit_card_step_path(step.card, step), class: "step__content") { tag.span step.content, class: "step__content" } %>
  </li>
<% end %>
