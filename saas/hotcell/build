#!/usr/bin/env bash
# Builds the cell's image, at the hotcell revision the application is running.
#
# The application's lockfile is the source of truth. This makes the cell's lockfile name the same revision
# — writing it if it differs — and then builds. A client and server one revision apart is a `protocol`
# failure on every request, so the two are never allowed to be set separately: update the gem in the app,
# run this, commit the lot as one change.
#
# It touches no registry: publishing is saas/hotcell/deploy, so this can run on every laptop from
# bin/setup. Tags are immutable and there is no `latest`, because a deploy does not update an accessory —
# `kamal accessory reboot` pulls whatever the tag names at that moment, and a moving tag would make what a
# host runs depend on when it last rebooted.
set -euo pipefail

cell_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$cell_dir/../.." && pwd)"

source "$cell_dir/image"

platform=""
for arg in "$@"; do
  case $arg in
    --platform=*) platform="${arg#*=}" ;;
    --help|-h)
      cat <<USAGE
Usage: saas/hotcell/build [--platform=linux/amd64]

Locks saas/hotcell/Gemfile.lock to the hotcell revision in Gemfile.saas.lock, builds the cell image, and
tags it with a hash of what went into it. Pushing is a separate step: saas/hotcell/deploy.

To move the cell to a new hotcell revision, update the gem in the application first:

    BUNDLE_GEMFILE=Gemfile.saas bundle update hotcell-client activestorage-hotcell-client
    saas/hotcell/build

then commit the two lockfiles, the deploy.yml pin, and anything else, together.

Environment:
  GITHUB_TOKEN   Defaults to the gh CLI's oauth token. The cell's bundle comes from a private
                 repository, so the build needs one.
USAGE
      exit 0
      ;;
  esac
done

# The revision the application runs. Read off the lockfile rather than asked of bundler, so this needs no
# bundle to be installed and cannot be answered by a stale one.
app_revision="$(awk '/remote: https:\/\/github.com\/basecamp\/hotcell/{f=1} f&&/revision:/{print $2; exit}' "$repo_root/Gemfile.saas.lock")"
cell_revision="$(awk '/remote: https:\/\/github.com\/basecamp\/hotcell/{f=1} f&&/revision:/{print $2; exit}' "$cell_dir/Gemfile.lock")"

if [ -z "$app_revision" ]; then
  echo "Gemfile.saas.lock names no hotcell revision. Is the app in SaaS mode?" >&2
  exit 1
fi

# The cell's Gemfile pins the branch, so `bundle update` would take the branch head rather than the
# application's revision. Setting the revision in the lockfile and installing against it is what pins the
# cell to exactly what the app runs; bundler honours the lockfile's revision over the branch's tip.
if [ "$cell_revision" != "$app_revision" ]; then
  echo "Locking the cell to the application's hotcell revision ${app_revision:0:8} (was ${cell_revision:0:8})"
  sed -i "s/revision: $cell_revision/revision: $app_revision/" "$cell_dir/Gemfile.lock"
  env -u RUBYOPT -u RUBYLIB -u BUNDLER_SETUP -u BUNDLER_VERSION -u BUNDLE_BIN_PATH -u BUNDLE_LOCKFILE \
    BUNDLE_GEMFILE="$cell_dir/Gemfile" bundle install --quiet
fi

# Exported, not just set: --secret env=GITHUB_TOKEN reads the environment, and a shell variable that is
# only assigned reaches the build as an empty string — which fails as "Authentication failed" rather
# than as a missing credential.
: "${GITHUB_TOKEN:=$(gh config get -h github.com oauth_token 2>/dev/null || true)}"
export GITHUB_TOKEN
if [ -z "$GITHUB_TOKEN" ]; then
  echo "GITHUB_TOKEN is unset and the gh CLI has no token. Run: gh auth login" >&2
  exit 1
fi

tag="$(hotcell_image_tag "$repo_root")"

echo "Building $tag"
docker build \
  ${platform:+--platform="$platform"} \
  --secret id=GITHUB_TOKEN,env=GITHUB_TOKEN \
  --tag "$tag" \
  "$cell_dir"

# Bundler writes the token into every git remote it touches, in more places than one line of the
# Dockerfile can be trusted to name. A credential that reaches the image is inside the blast radius, so
# check the built bytes rather than the intent.
#
# As root, because the image runs as 10001 and /root is mode 700 — a scan that cannot read what it names is
# not a scan. And grep alone, because a pipeline's status is its last command's: with `| head` the status
# was always success, so neither a refused path nor a failed `docker run` could be told from a clean image.
echo "Checking the image for the credential"
set +e
leaked="$(docker run --rm --user 0 --entrypoint sh -e TOKEN="$GITHUB_TOKEN" "$tag" \
  -c 'grep -rlF "$TOKEN" /hotcell /usr/local/bundle /root /home /tmp')"
scan_status=$?
set -e

# Only a clean answer passes: publishing an image nobody could look at is the same mistake as publishing a
# leaky one. The tag survives either way — deleting it is yours to do, and a leaky image is worth opening
# before it goes.
case $scan_status in
  1) ;;  # grep found nothing
  0)
    echo "The GITHUB_TOKEN survived into $tag, in:" >&2
    echo "$leaked" >&2
    echo "Widen the rm in the Dockerfile. Do not publish this image; delete it with:" >&2
    echo "  docker image rm --force $tag" >&2
    exit 1
    ;;
  *)
    echo "The credential scan did not run (exit $scan_status), so $tag is unverified." >&2
    echo "Do not publish it until the scan passes. Delete it with:" >&2
    echo "  docker image rm --force $tag" >&2
    exit 1
    ;;
esac

pinned="$(grep -o 'fizzy-hotcell:[a-f0-9]*' "$repo_root/saas/config/deploy.yml" | head -1 | cut -d: -f2)"

echo
echo "Built $tag. It is local only — publish it with saas/hotcell/deploy."
if [ "$pinned" != "${tag##*:}" ]; then
  echo
  echo "saas/config/deploy.yml pins fizzy-hotcell:$pinned. Point it at this build:"
  echo
  echo "    image: $tag"
fi
